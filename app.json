{
  "expo": {
    "name": "ORB",
    "slug": "ORB",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/orb.png",
    "scheme": "orb",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.hal716.orb",
      "supportsTablet": true
    },
    "android": {
      "package": "com.hal716.orb",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/icons/orb.png",
        "backgroundImage": "./assets/icons/orb.png",
        "monochromeImage": "./assets/icons/orb.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "@clerk/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf170437-d52b-4824-a03d-eb1e24ebab37"
      }
    },
    "owner": "hal716"
  }
}
